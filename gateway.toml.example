[gateway]
# Das RCON-Ziel. Das Master-Passwort steht NICHT in dieser Datei.
rcon_base_url = "http://111.111.111.111:1111/v1"
request_timeout = 10
listen_host = "127.0.0.1"
listen_port = 1112
database = "data/gateway.db"

# Getrennte strukturierte JSONL-Logs.
client_log_file = "logs/rcon-client.log"
server_log_file = "logs/rcon-server.log"

# Reale RCON-Seite: Gesamtbudget aller Requests zum echten RCON.
global_requests_per_minute = 540
# Client-Seite: pro Key nur für echte Passthrough-Requests (nicht für GET-Cache-Hits).
per_key_requests_per_minute = 180

# GET-Cache
cache_enabled = true
cache_refresh_interval = 1.0
cache_persist_interval = 5.0
cache_file = "data/get-cache.json"
cache_max_dynamic_entries = 128
# false ist absichtlich sicherer: alle statischen GET-Routen aus capabilities bei 1 s
# können zusammen das echte RCON-Limit von 600/min überschreiten.
cache_auto_register_static_gets = false

# Diese häufigen GETs werden direkt beim Start jede Sekunde aktualisiert.
# Weitere GET-Pfade/Query-Varianten werden beim ersten erlaubten Clientzugriff registriert
# und danach ebenfalls jede Sekunde aktualisiert.
cache_preload_paths = [
  "/v1/health",
  "/v1/capabilities",
  "/v1/status",
  "/v1/players",
  "/v1/reserved-slots",
]
